# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# Виртуальное окружение
venv/
env/
.venv/

# Переменные окружения
.env

# ============================================================
# IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# uv
# ============================================================
uv.lock

# ============================================================
# Артефакты приложения
# ============================================================

# ChromaDB — персистентное хранилище индексов
chroma_storage/*
!chroma_storage/.gitkeep

# Логи
logs/*
!logs/.gitkeep

# Сессии пользователей (история диалогов)
data/sessions/*
!data/sessions/.gitkeep

# Метрики
data/metrics/*
!data/metrics/.gitkeep

