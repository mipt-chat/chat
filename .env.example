# ============================================================
# Customer Support AI Bot — Переменные окружения
# Скопируйте этот файл в .env и заполните значения
# ============================================================

# --- Общие настройки ---
APP_NAME=CustomerSupportBot
DEBUG=false

# --- База знаний ---
KNOWLEDGE_BASE_FILE=knowledge_base/root.yaml

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=chroma_storage
CHROMA_COLLECTION_NAME=support_knowledge

# --- Модель эмбеддингов ---
# Рекомендуется multilingual модель, например:
# intfloat/multilingual-e5-base
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# --- RAG параметры ---
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- LLM Провайдеры ---
# Активный провайдер: yandex | giga | openai_compatible
ACTIVE_LLM_PROVIDER=yandex

# YandexGPT (через OpenAI-совместимый API)
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_MODEL_NAME=yandexgpt

# GigaChat
GIGACHAT_API_KEY=your-gigachat-api-key
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL_NAME=GigaChat

# Универсальный OpenAI-совместимый провайдер (Ollama, self-hosted и т.д.)
OPENAI_COMPATIBLE_API_KEY=your-api-key
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL_NAME=llama3

# --- Fallback ---
# Ответ, когда в базе знаний нет релевантной информации
FALLBACK_ANSWER=Извините, я не нашёл ответ на ваш вопрос в базе знаний. Пожалуйста, уточните запрос или обратитесь к оператору поддержки.

# --- История диалогов ---
# Количество последних сообщений, учитываемых в контексте
MAX_HISTORY_LENGTH=5
# Время жизни сессии в днях (0 = не удалять)
SESSION_TTL_DAYS=30

# --- Логирование ---
LOG_LEVEL_CONSOLE=DEBUG
LOG_LEVEL_FILE=INFO
LOG_DIR=logs
LOG_FILE=bot.log
